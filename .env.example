# ---------------------------------------------------------------------------
# JellyTTV configuration
# Copy to `.env` and edit. Everything here can also be changed later in the UI,
# except the paths and the session secret.
# ---------------------------------------------------------------------------

# Host port the web UI / tuner endpoints are published on.
JELLYTTV_PORT=8730

# Where JellyTTV writes the .strm/.nfo/artwork tree.
# This MUST be mounted into Jellyfin as a "Shows" library.
# Example: /srv/media/twitch  (host)  ->  /media/twitch (jellyfin container)
MEDIA_ROOT=./data/media

# Where the SQLite database, encryption key and logs live.
CONFIG_ROOT=./data/config

# Random string used to sign admin session cookies.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JELLYTTV_SESSION_SECRET=change-me-to-a-long-random-string

# Public HTTPS base URL of this instance. REQUIRED for Twitch EventSub webhooks
# (Twitch only calls back to port 443 with a valid certificate).
# Leave empty to run in polling-only mode (works fine on a LAN).
JELLYTTV_PUBLIC_BASE_URL=

# Optional: run everything as a specific uid/gid so Jellyfin can read the files.
PUID=1000
PGID=1000
TZ=UTC

# Log level: DEBUG | INFO | WARNING | ERROR
JELLYTTV_LOG_LEVEL=INFO
# Log format: console | json
JELLYTTV_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Optional: only used by the `with-caddy` compose profile
# ---------------------------------------------------------------------------
# JELLYTTV_DOMAIN=jellyttv.example.com
# CADDY_EMAIL=you@example.com
